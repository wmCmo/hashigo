{
  // The sync mailbox on Cloudflare — see src/mailbox.ts for what it is and why.
  "name": "hashigo-mailbox",
  "main": "src/mailbox.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // No per-version preview URLs: one public address for a mailbox of his history.
  "preview_urls": false,
  "kv_namespaces": [
    // Created 2026-09-26 with `wrangler kv namespace create MAILBOX`.
    { "binding": "MAILBOX", "id": "1d33ef525a084e5b852fb5cb78f72311" }
  ],
  "vars": {
    // Where the app is served from. The laptop's tailnet name, and the two
    // localhost ports (dev 5274, preview 4274) for testing on the laptop.
    "ALLOWED_ORIGINS": "https://node.tailed819e.ts.net,http://127.0.0.1:5274,http://127.0.0.1:4274,http://localhost:5274,http://localhost:4274"
  }
  // MAILBOX_TOKEN is a SECRET, set with `wrangler secret put MAILBOX_TOKEN`,
  // never written here.
}

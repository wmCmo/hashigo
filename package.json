{
  "name": "hashigo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first spaced-repetition app replacing Mochi. See SPEC.html.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/sources": {
      "types": "./dist/schema/sources.d.ts",
      "default": "./dist/schema/sources.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "default": "./dist/template/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    },
    "./blobs": {
      "types": "./dist/blobs/index.d.ts",
      "default": "./dist/blobs/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./render/reveal": {
      "types": "./dist/render/reveal.d.ts",
      "default": "./dist/render/reveal.js"
    },
    "./render/audio": {
      "types": "./dist/render/audio.d.ts",
      "default": "./dist/render/audio.js"
    },
    "./render/ruby": {
      "types": "./dist/render/ruby.d.ts",
      "default": "./dist/render/ruby.js"
    },
    "./render/draw": {
      "types": "./dist/render/draw.d.ts",
      "default": "./dist/render/draw.js"
    },
    "./render/input": {
      "types": "./dist/render/input.d.ts",
      "default": "./dist/render/input.js"
    },
    "./render/math": {
      "types": "./dist/render/math.d.ts",
      "default": "./dist/render/math.js"
    },
    "./fields": {
      "types": "./dist/fields/index.d.ts",
      "default": "./dist/fields/index.js"
    },
    "./accent": {
      "types": "./dist/accent/index.d.ts",
      "default": "./dist/accent/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./cards": {
      "types": "./dist/cards/index.d.ts",
      "default": "./dist/cards/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "default": "./dist/review/index.js"
    },
    "./backup": {
      "types": "./dist/backup/index.d.ts",
      "default": "./dist/backup/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "default": "./dist/scheduler/index.js"
    },
    "./scheduler/algorithms": {
      "types": "./dist/scheduler/algorithms/index.d.ts",
      "default": "./dist/scheduler/algorithms/index.js"
    },
    "./scheduler/backtest": {
      "types": "./dist/scheduler/backtest.d.ts",
      "default": "./dist/scheduler/backtest.js"
    },
    "./scheduler/policy": {
      "types": "./dist/scheduler/policy.d.ts",
      "default": "./dist/scheduler/policy.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:raw": "vitest run",
    "test:watch": "vitest",
    "gates": "node scripts/gates.mjs",
    "rebuild": "node scripts/rebuild.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:verify": "node scripts/build.mjs --verify-only",
    "import": "vite-node scripts/import.ts --",
    "dashboard": "vite-node src/dashboard/cli.ts --",
    "app:bootstrap": "vite-node scripts/app-bootstrap.ts --",
    "app:dev": "vite --config vite.app.config.ts",
    "app:build": "vite build --config vite.app.config.ts",
    "app:build:cloud": "vite build --config vite.app.config.ts --mode cloud",
    "app:preview": "vite preview --config vite.app.config.ts",
    "phone": "node scripts/phone.mjs",
    "app:check": "tsc -p app/tsconfig.json",
    "spike:bootstrap": "node spike/make-bootstrap.mjs",
    "spike:dev": "vite",
    "spike:build": "vite build",
    "spike:preview": "vite preview",
    "spike:check": "tsc --noEmit --strict --exactOptionalPropertyTypes --noUncheckedIndexedAccess --target ES2023 --module nodenext --moduleResolution nodenext --lib ES2023,DOM,DOM.Iterable --skipLibCheck spike/contract-compat.ts"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "better-sqlite3": "^12.6.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}

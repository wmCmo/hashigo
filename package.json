{
  "name": "hashigo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first spaced-repetition app replacing Mochi. See SPEC.html.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "default": "./dist/template/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    },
    "./blobs": {
      "types": "./dist/blobs/index.d.ts",
      "default": "./dist/blobs/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./scheduler/algorithms": {
      "types": "./dist/scheduler/algorithms/index.d.ts",
      "default": "./dist/scheduler/algorithms/index.js"
    },
    "./scheduler/backtest": {
      "types": "./dist/scheduler/backtest.d.ts",
      "default": "./dist/scheduler/backtest.js"
    },
    "./scheduler/policy": {
      "types": "./dist/scheduler/policy.d.ts",
      "default": "./dist/scheduler/policy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:verify": "node scripts/build.mjs --verify-only",
    "import": "vite-node scripts/import.ts --",
    "dashboard": "vite-node src/dashboard/cli.ts --",
    "spike:bootstrap": "node spike/make-bootstrap.mjs",
    "spike:dev": "vite",
    "spike:build": "vite build",
    "spike:preview": "vite preview",
    "spike:check": "tsc --noEmit --strict --exactOptionalPropertyTypes --noUncheckedIndexedAccess --target ES2023 --module nodenext --moduleResolution nodenext --lib ES2023,DOM,DOM.Iterable --skipLibCheck spike/contract-compat.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "better-sqlite3": "^12.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}

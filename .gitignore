# Reference data, not source: 657 MB of Azure-generated mp3 plus 25 MB of data.json.
exports/
*.mochi

# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
coverage/

# Content-addressed blob store. The bytes it holds are the same 657 MB of mp3
# that exports/ holds, re-sharded by hash — the repo must never gain them.
#
# `<db>.blobs` is the shape `defaultStoreRoot()` in src/blobs/node.ts produces,
# so the default store beside build/hashigo.db is covered twice over. It is
# NOT anchored, because the root travels with whatever --db the user names.
# The rest ARE anchored with a leading slash on purpose: an unanchored
# `blobs/` would also match `src/blobs/`, which is source code.
*.blobs/
/blobs/
/blobstore/
/.hashigo/
/media/
/data/

# Second net, in case the store root moves or someone points it somewhere new:
# no generated audio or video enters this repo by any path. There are zero
# tracked media files today (`git ls-files` over these extensions is empty), so
# this ignores nothing that exists and everything that would be a mistake.
*.mp3
*.m4a
*.wav
*.ogg
*.opus
*.flac
*.mp4
*.webm

# Local SQLite stores (the OPFS/Node databases are always rebuildable from exports/)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Scratch output: throwaway scripts, measurement dumps, agent working files
scratch/
tmp/
out/
.playwright-mcp/
*.log
__pycache__/
*.pyc

# Secrets: Azure TTS, translation and LLM keys
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

.obsidian
# The accent analyser venv. pyopenjtalk-plus + fugashi + UniDic 2.3.0 is
# ~1.4 GB of dictionary; rebuild it with the two commands in
# notes/pitch-accent-pipeline.md rather than committing it.
.venv-accent/

# The Claude Code browser pane's dev-server launcher. Machine-local tooling, not
# project config -- `npm run app:dev` is the documented way in. The rest of
# .claude/ is deliberately NOT ignored, so shared agent config can live there.
.claude/launch.json

# `npm run phone` writes the live tunnel hostname here; vite.app.config.ts
# appends it to `allowedHosts`. Local and ephemeral — never committed.
.tunnel-host
.tunnel-named

# `tailscale cert <host>` writes the pair into the CURRENT directory — a private
# key in the repo root, untracked and previously not ignored. `tailscale serve`
# manages its own certs and needs none of this; the only way these appear is
# someone probing whether certs work. Ignored so a probe can never be committed.
*.ts.net.crt
*.ts.net.key

# Webfonts, built by `python tools/fonts.py`.
# The SHIPPING faces are committed: the app is offline-first and must not need a
# build step to render its own text. Decision 57: Noto Sans JP 400 and Hanken
# Grotesk 400/600/700/800. `zenkaku-med` stays because `scripts/ojad-preview.ts`
# renders with it.
app/fonts/*
!app/fonts/notosansjp-400.woff2
!app/fonts/hanken-400.woff2
!app/fonts/hanken-600.woff2
!app/fonts/hanken-700.woff2
!app/fonts/hanken-800.woff2
!app/fonts/zenkaku-med.woff2
build/fonts-src/

# Wrangler state for cloud/ (local dev store, cached tokens)
.wrangler/
